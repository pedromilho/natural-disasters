$C = "../Common.ui";

Group {
  LayoutMode: Top;
  Group { FlexWeight: 1; }
  Group {
    LayoutMode: Center;
    Anchor: (Height: 430);
    $C.@Panel {
      Anchor: (Width: 500, Height: 430);
      Padding: (Full: 20);
      LayoutMode: Top;

      Label {
        Anchor: (Height: 29);
        Text: "Natural Disasters";
        Style: (FontSize: 24, RenderBold: true, TextColor: #edf5ff, VerticalAlignment: Center);
      }
      Label #Subtitle {
        Anchor: (Height: 24, Top: 3, Bottom: 14);
        Style: (FontSize: 14, TextColor: #a8bdd0, VerticalAlignment: Center);
      }

      Group {
        LayoutMode: Top;
        Anchor: (Height: 128);
        Padding: (Full: 12);
        Background: #162736;

        Group {
          LayoutMode: Left;
          Anchor: (Height: 26);
          Label {
            Text: "Blizzard";
            FlexWeight: 1;
            Style: (FontSize: 18, RenderBold: true, TextColor: #e4f3ff, VerticalAlignment: Center);
          }
          Label #Status {
            Anchor: (Width: 180);
            Style: (FontSize: 14, TextColor: #a7dbff, HorizontalAlignment: End, VerticalAlignment: Center);
          }
        }
        Label #Details {
          Anchor: (Height: 24, Bottom: 10);
          Style: (FontSize: 13, TextColor: #a8bdd0, VerticalAlignment: Center);
        }
        Group {
          LayoutMode: Left;
          Anchor: (Height: 34);
          $C.@TextButton #StartBlizzard {
            @Text = "Start Blizzard";
            Anchor: (Height: 34, Width: 177, Right: 8);
          }
          $C.@SmallSecondaryTextButton #StopBlizzard {
            @Text = "Stop Test";
            Anchor: (Height: 34, Width: 140);
          }
        }
      }

      Group {
        LayoutMode: Top;
        Anchor: (Height: 128, Top: 12);
        Padding: (Full: 12);
        Background: #2c2627;

        Group {
          LayoutMode: Left;
          Anchor: (Height: 26);
          Label {
            Text: "Earthquake";
            FlexWeight: 1;
            Style: (FontSize: 18, RenderBold: true, TextColor: #ffeadc, VerticalAlignment: Center);
          }
          Label #EarthquakeStatus {
            Anchor: (Width: 205);
            Style: (FontSize: 14, TextColor: #f1bda0, HorizontalAlignment: End, VerticalAlignment: Center);
          }
        }
        Label #EarthquakeDetails {
          Anchor: (Height: 24, Bottom: 10);
          Style: (FontSize: 13, TextColor: #d5bbaf, VerticalAlignment: Center);
        }
        Group {
          LayoutMode: Left;
          Anchor: (Height: 34);
          $C.@SmallSecondaryTextButton #QuakeLight {
            @Text = "Light";
            Anchor: (Height: 34, Width: 92, Right: 8);
          }
          $C.@SmallSecondaryTextButton #QuakeModerate {
            @Text = "Moderate";
            Anchor: (Height: 34, Width: 102, Right: 8);
          }
          $C.@TextButton #QuakeStrong {
            @Text = "Strong";
            Anchor: (Height: 34, Width: 92, Right: 8);
          }
          $C.@SmallSecondaryTextButton #StopEarthquake {
            @Text = "Stop Test";
            Anchor: (Height: 34, Width: 120);
          }
        }
      }

      Group { FlexWeight: 1; }
      Group {
        Anchor: (Height: 32);
        LayoutMode: Left;
        Group { FlexWeight: 1; }
        $C.@SmallSecondaryTextButton #Close {
          @Text = "Close";
          Anchor: (Width: 104, Height: 32);
        }
      }
    }
  }
  Group { FlexWeight: 1; }
}
